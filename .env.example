# Copy this file to .env and fill in your values. Never commit .env.

# ElevenLabs (https://elevenlabs.io -> Profile -> API keys). Leave empty to use browser speech.
ELEVENLABS_API_KEY=
# Voice ID from the ElevenLabs Voice Library (e.g. "JBFqnCBsd6RMkjVDRZzb" is "George").
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_multilingual_v2 = most natural voice. eleven_flash_v2_5 = fastest (lower latency).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Gemini (https://aistudio.google.com/apikey, free). Powers Snap: learn words from your webcam.
GEMINI_API_KEY=
# gemini-3.5-flash-lite answers in ~1 s; gemini-3.8-flash is slower (~3-9 s).
GEMINI_MODEL=gemini-3.5-flash-lite

# Letters on the rotating braille wheel (same as WHEEL_LETTERS in braille_remote.ino).
# Gemini prefers words spelled with these; other letters are shown on the LEDs instead.
WHEEL_LETTERS=abceilnp

# What is spoken before each letter/number, so "A" isn't read as the word "a".
# Set to empty to speak just the character.
SPEAK_LETTER_PREFIX=Letter
SPEAK_NUMBER_PREFIX=Number

# Arduino. Leave ARDUINO_PORT empty to auto-detect, or set e.g. /dev/cu.usbmodem1101 (Mac) or COM3 (Windows).
# Set to "mock" to never connect.
ARDUINO_PORT=
ARDUINO_BAUD=9600

# Web server
PORT=8000
